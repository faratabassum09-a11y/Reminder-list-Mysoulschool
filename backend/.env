# Comma-separated list of allowed frontend origins in production, e.g.
# https://your-app.vercel.app. Leave unset for local dev (allows all).
FRONTEND_URL=

# Required. A long random string used to sign login sessions — anyone who
# has this can forge a valid login, so keep it secret and never commit a
# real value. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=19ab895d0eab4abfb3eeabb7dabff76a1ec726d24a78d3248bc4232005e38bfb

# Daily "tasks due tomorrow" reminder emails + the per-doer "Email Tasks"
# button. Gmail with an App Password only — leave blank to keep the
# feature harmless (it'll just log instead of sending).
#
# How to get an App Password:
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Go to myaccount.google.com/apppasswords, create one (any name), and
#      copy the 16-character password it shows you.
#   3. SMTP_USER is the full Gmail address. SMTP_PASS is that 16-character
#      App Password — NOT the normal Gmail login password (Gmail will
#      reject that).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. A Redis connection string that turns on caching for the
# heaviest-read pages (Doers, Tasks, Settings lists) and stops the
# automatic "generate upcoming occurrences" check from re-running for
# every single person who opens Master — worth setting once more than a
# few people use the app at the same time. Leave blank and the app runs
# exactly as before, just without the speed-up. Any managed free Redis
# works, e.g. a Redis instance on Render or Upstash:
#   REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_URL=redis://red-dap28jf40ujc73ba9k60:6379

# Required for MySoul Assistant (the chatbot) to answer open-ended questions beyond its
# built-in quick answers. Get a free key at https://aistudio.google.com/apikey
# Leave blank and MySoul Assistant still works — it just tells people AI answers aren't
# turned on yet instead of calling out to Gemini.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash if unset. Set this instead of
# editing code if Google renames/retires the model again later.
GEMINI_MODEL=
